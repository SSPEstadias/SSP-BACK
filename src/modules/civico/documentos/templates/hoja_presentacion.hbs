<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <title>Hoja de Presentación — {{nombreBeneficiario}}</title>
  <style>
    @page {
      size: Letter;
      margin: 0;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html,
    body {
      width: 21.59cm;
      height: 27.94cm;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 11pt;
      color: #000;
      line-height: 1.4;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    /* ── Contenedor principal con márgenes internos ── */
    .pagina {
      position: relative;
      width: 21.59cm;
      padding: 1.5cm 2cm 1.5cm 2cm;
    }

    .header-logos {
      text-align: center;
      margin-bottom: 25pt;
    }

    .img-logo-1 {
      max-height: 170px;
      width: auto;
      margin-bottom: 5pt;
    }

    .img-logo-2 {
      max-height: 200px;
      width: auto;
    }

    .plan-title {
      font-size: 11pt;
      text-transform: uppercase;
      margin-bottom: 15pt;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .nombre-row {
      margin-bottom: 20pt;
      font-size: 11pt;
    }

    .underline-field {
      border-bottom: 1px solid #000;
      display: inline-block;
      min-width: 450px;
      padding-left: 5px;
    }

    .asistencia-table {
      border: 1px solid #000;
      border-collapse: collapse;
      width: 100%;
      table-layout: fixed;
      font-size: 10.5pt;
    }

    .asistencia-table th {
      border: 1px solid #000;
      padding: 6pt;
      text-align: center;
      font-weight: normal;
      text-decoration: underline;
      width: 25%;
    }

    .asistencia-table td {
      border: 1px solid #000;
      padding: 6pt;
      vertical-align: top;
      height: 90pt;
      /* Dar espacio a las celdas vacías */
      word-wrap: break-word;
    }

    .obs-cell {
      height: auto;
      vertical-align: middle !important;
    }
  </style>
</head>

<body>

  <div class="pagina">

    <div class="header-logos">
      {{#if logoPresentacion1}}
      <div><img src="{{logoPresentacion1}}" class="img-logo-1" alt="Secretaría" /></div>
      {{/if}}
      {{#if logoPresentacion2}}
      <div><img src="{{logoPresentacion2}}" class="img-logo-2" alt="Reconecta" /></div>
      {{/if}}
    </div>

    <div class="plan-title">
      <span>PLAN DE TRABAJO: <u>PRESENTACIONES SOCIALES</u></span>
      <span>FECHA: <u>{{#if
          fechaHoja}}{{fechaHoja}}{{else}}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{{/if}}</u></span>
    </div>

    <div class="nombre-row">
      NOMBRE: <span class="underline-field">{{#if nombreBeneficiario}}{{nombreBeneficiario}}{{else}}&nbsp;{{/if}}</span>
    </div>

    <table class="asistencia-table">
      <thead>
        <tr>
          <th>HORARIO</th>
          <th>ACTIVIDAD</th>
          <th>SEDE</th>
          <th class="firma-col">FIRMA</th>
        </tr>
      </thead>
      <tbody>
        {{#each actividades}}
        <tr>
          <td>{{horario}}</td>
          <td>{{actividad}}</td>
          <td>{{sede}}</td>
          <td class="firma-col">{{firma}}</td>
        </tr>
        {{/each}}

        {{!-- Filas vacías adicionales. Usamos filasVacias sin paréntesis para evitar el TypeError --}}
        {{#times filasVacias}}
        <tr>
          <td>&nbsp;</td>
          <td>&nbsp;</td>
          <td>&nbsp;</td>
          <td class="firma-col">&nbsp;</td>
        </tr>
        {{/times}}

        <!-- Fila de OBSERVACIONES combinada -->
        <tr>
          <td style="text-align: center; vertical-align: middle;">OBSERVACIONES</td>
          <td colspan="3" class="obs-cell">
            {{#if observaciones}}{{observaciones}}{{else}}&nbsp;{{/if}}
          </td>
        </tr>
      </tbody>
    </table>

  </div>

</body>

</html>