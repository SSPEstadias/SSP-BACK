{{!-- Hoja de Presentación al Programa — SSPC Reconecta con la Paz --}}
{{!--
  Variables requeridas del contexto (documentos.service.ts → generarHojaPresentacion):
    nombreBeneficiario  — Nombre del beneficiario
    fechaHoja           — Fecha de la hoja (ej: dd/mm/yyyy)
    actividades         — Array de actividades [{horario, actividad, sede, firma}]
                          (si no se provee, se imprimen filas vacías)
    filasVacias         — Número de filas vacías adicionales a imprimir (default: 5)

  Variables opcionales:
    tituloDocumento     — default "HOJA DE PRESENTACIÓN AL PROGRAMA"
    observaciones       — Observaciones del guía
    nombreGuia          — Nombre del guía asignado
--}}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Hoja de Presentación — {{nombreBeneficiario}}</title>
  <style>
    @page { size: Letter; margin: 2.5cm 2cm 1.5cm 2cm; }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Times New Roman', Times, serif; font-size: 11pt; color: #000; line-height: 1.5; }
    .watermark-container { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; display: flex; align-items: center; justify-content: center; pointer-events: none; }
    .watermark-img { width: 55%; opacity: 0.08; }
    .header-table { width: 100%; border-collapse: collapse; margin-bottom: 4pt; }
    .header-logo  { width: 210px; vertical-align: middle; padding-right: 14pt; }
    .logo-img     { width: 200px; height: auto; }
    .header-title { vertical-align: middle; text-align: center; }
    .header-dep   { font-size: 10.5pt; font-weight: bold; text-transform: uppercase; letter-spacing: 0.4pt; }
    .header-prog  { font-size: 10pt; font-weight: bold; color: #1a3a6b; }
    .header-sub   { font-size: 9pt; color: #555; }
    .header-doc-title { font-size: 10pt; font-weight: bold; margin-top: 3pt; text-decoration: underline; }
    .header-divider { border-top: 2px solid #1a3a6b; margin: 6pt 0 10pt 0; }
    .doc-footer { position: fixed; bottom: 0; left: 0; right: 0; }
    .footer-divider { border-top: 1px solid #999; margin-bottom: 3pt; }
    .footer-table { width: 100%; border-collapse: collapse; font-size: 8pt; color: #555; }
    .footer-left  { text-align: left; } .footer-center { text-align: center; } .footer-right { text-align: right; }
    .content { margin-top: 8pt; }
    .info-row { margin-bottom: 14pt; }
    .info-label { font-weight: bold; text-transform: uppercase; }
    .plan-title { font-size: 12pt; font-weight: bold; text-transform: uppercase; text-align: center; margin-bottom: 12pt; border-bottom: 2px solid #1a3a6b; padding-bottom: 4pt; }
    .nombre-row { margin-bottom: 18pt; font-size: 11pt; }
    .underline-field { border-bottom: 1px solid #000; display: inline-block; min-width: 300px; }
    .asistencia-table { border: 1px solid #999; border-collapse: collapse; width: 100%; margin-top: 14pt; font-size: 10.5pt; }
    .asistencia-table th { background-color: #1a3a6b; color: #fff; padding: 5pt 8pt; border: 1px solid #999; text-align: center; }
    .asistencia-table td { border: 1px solid #ccc; padding: 14pt 8pt; vertical-align: top; }
    .asistencia-table .firma-col { width: 100pt; }
    .obs-section { margin-top: 16pt; }
    .obs-label { font-weight: bold; text-transform: uppercase; margin-bottom: 4pt; }
    .obs-box { border: 1px solid #ccc; min-height: 60pt; padding: 6pt 8pt; font-size: 10.5pt; }
    .guia-firma-row { margin-top: 28pt; text-align: right; }
    .firma-linea { border-top: 1px solid #000; width: 220px; margin-top: 40pt; display: inline-block; }
    .firma-nombre { font-weight: bold; font-size: 10pt; margin-top: 3pt; }
    .firma-cargo  { font-size: 9.5pt; }
  </style>
</head>
<body>

{{> _watermark}}

{{> _header tituloDocumento="HOJA DE PRESENTACIÓN AL PROGRAMA"}}

<div class="content">

  <div class="plan-title">
    PLAN DE TRABAJO: PRESENTACIONES SOCIALES &nbsp;&nbsp;&nbsp; FECHA: {{#if fechaHoja}}{{fechaHoja}}{{else}}_____________{{/if}}
  </div>

  <div class="nombre-row">
    NOMBRE: <span class="underline-field">{{#if nombreBeneficiario}}{{nombreBeneficiario}}{{else}}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{{/if}}</span>
  </div>

  <!-- Tabla de actividades -->
  <table class="asistencia-table">
    <thead>
      <tr>
        <th>HORARIO</th>
        <th>ACTIVIDAD</th>
        <th>SEDE</th>
        <th class="firma-col">FIRMA</th>
      </tr>
    </thead>
    <tbody>
      {{#each actividades}}
      <tr>
        <td>{{horario}}</td>
        <td>{{actividad}}</td>
        <td>{{sede}}</td>
        <td class="firma-col">{{firma}}</td>
      </tr>
      {{/each}}
      {{!-- Filas vacías adicionales --}}
      {{#times (filasVacias)}}
      <tr>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
        <td class="firma-col">&nbsp;</td>
      </tr>
      {{/times}}
    </tbody>
  </table>

  <!-- Observaciones -->
  <div class="obs-section">
    <p class="obs-label">OBSERVACIONES</p>
    <div class="obs-box">{{#if observaciones}}{{observaciones}}{{else}}&nbsp;{{/if}}</div>
  </div>

  <!-- Firma del guía -->
  {{#if nombreGuia}}
  <div class="guia-firma-row">
    <div class="firma-linea"></div>
    <p class="firma-nombre">{{nombreGuia}}</p>
    <p class="firma-cargo">Guía Asignado</p>
  </div>
  {{/if}}

</div>

{{> _footer}}

</body>
</html>
