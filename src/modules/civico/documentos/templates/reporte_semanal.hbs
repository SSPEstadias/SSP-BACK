<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <title>Reporte Semanal de Actividades — {{nombreBeneficiario}}</title>
  <style>
    @page {
      size: Letter;
      margin: 0;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html,
    body {
      width: 21.59cm;
      height: 27.94cm;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 10pt;
      color: #000;
      line-height: 1.3;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    /* ── Fondo / Grecas ── */
    .grecas-lateral {
      position: fixed;
      top: 0;
      right: 0;
      width: 2.4cm;
      height: 100%;
      z-index: -1;
      object-fit: cover;
      opacity: 0.18;
    }

    /* ── Contenedor principal ── */
    .pagina {
      position: relative;
      width: 21.59cm;
      padding: 1cm 3.5cm 1cm 1.5cm; /* Margen derecho amplio para no pisar las grecas */
    }

    /* ── Encabezado ── */
    .header-section {
      text-align: center;
      margin-bottom: 20pt;
    }

    .img-logo {
      max-height: 80px;
      width: auto;
      margin-bottom: 8pt;
    }

    .header-text {
      font-size: 9pt;
      font-weight: bold;
      text-transform: uppercase;
      color: #666;
    }

    /* ── Tabla Reporte ── */
    .reporte-table {
      width: 100%;
      border-collapse: collapse;
      border: 1px solid #000;
      margin-top: 10pt;
    }

    .reporte-table td, 
    .reporte-table th {
      border: 1px solid #000;
      padding: 6pt;
      vertical-align: middle;
      word-wrap: break-word;
    }

    .cell-title {
      font-weight: bold;
      text-decoration: underline;
      text-align: center;
    }

    .cell-label {
      font-weight: normal;
      background-color: #fff;
    }

    .header-row {
      background-color: #f2f2f2;
      text-align: center;
      font-weight: bold;
    }

    /* ── Alturas específicas ── */
    .row-meta { height: 45pt; }
    .row-full { height: 35pt; }
    .row-data { height: 60pt; }
    .row-obs  { height: 120pt; }

    /* ── Footer ── */
    .footer-address {
      position: fixed;
      bottom: 0.8cm;
      right: 3.5cm;
      text-align: right;
      font-size: 8pt;
      color: #444;
      line-height: 1.2;
    }
  </style>
</head>

<body>

  {{#if logoGrecas}}
  <img src="{{logoGrecas}}" class="grecas-lateral" />
  {{/if}}

  <div class="pagina">

    <div class="header-section">
      {{#if logoEncabezadoSspc}}
      <img src="{{logoEncabezadoSspc}}" class="img-logo" alt="SSPC" />
      {{/if}}
      <div class="header-text">
        SUBSECRETARÍA DE PREVENCIÓN Y REINSERCIÓN SOCIAL<br>
        DIRECCIÓN GENERAL DE PREVENCIÓN DEL DELITO Y PARTICIPACIÓN CIUDADANA
      </div>
    </div>

    <table class="reporte-table">
      <!-- Fila 1 -->
      <tr class="row-meta">
        <td style="width: 30%;" class="cell-title">Reporte semanal de actividades.</td>
        <td style="width: 15%;">Origen</td>
        <td style="width: 55%;">Unidad de Medidas Cautelares.</td>
      </tr>
      <!-- Fila 2 -->
      <tr class="row-meta">
        <td>Área: Reconecta con la Paz</td>
        <td>Periodo del reporte</td>
        <td>{{#if fechaPeriodo}}{{fechaPeriodo}}{{else}}{{fecha}}{{/if}}</td>
      </tr>
      <!-- Fila 3 -->
      <tr class="row-full">
        <td colspan="3">Guía: {{#if nombreGuia}}{{nombreGuia}}{{else}}—{{/if}}</td>
      </tr>
      <!-- Fila 4 -->
      <tr class="row-full">
        <td colspan="3">Nombre del Beneficiario: {{#if nombreBeneficiario}}{{nombreBeneficiario}}{{else}}—{{/if}}</td>
      </tr>
      <!-- Fila 5: Encabezados Columnas -->
      <tr class="header-row">
        <td>Asistencia</td>
        <td>Fecha de la actividad</td>
        <td>Descripción de la actividad.</td>
      </tr>
      
      <!-- Filas de Datos (Loop) -->
      {{#if actividades.length}}
        {{#each actividades}}
        <tr class="row-data">
          <td style="text-align: center;">{{asistencia}}</td>
          <td style="text-align: center;">{{fecha}}</td>
          <td>{{descripcion}}</td>
        </tr>
        {{/each}}
      {{else}}
        <!-- Fila vacía para llenar manual si no hay datos -->
        <tr class="row-data">
          <td>&nbsp;</td>
          <td>&nbsp;</td>
          <td>&nbsp;</td>
        </tr>
      {{/if}}

      <!-- Fila 7: Observaciones -->
      <tr class="row-obs">
        <td class="cell-title" style="vertical-align: top;">Observaciones:</td>
        <td colspan="2" style="vertical-align: top; padding: 10pt;">
          {{#if observaciones}}{{observaciones}}{{else}}&nbsp;{{/if}}
        </td>
      </tr>
    </table>

    <div class="footer-address">
      Fernando Montes de Oca N° 104<br>
      Col. Niños Héroes, Santa Lucía del Camino, Oaxaca<br>
      Teléfono: 951 513 3727 / 951 515 2013
    </div>

  </div>

</body>

</html>
