<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Nota de Evolución Psicológica — {{nombreUsuario}}</title>
  <style>
    @page {
      size: Letter;
      margin: 0;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      width: 21.59cm;
      font-family: 'Times New Roman', Times, serif;
      font-size: 10pt;
      color: #000;
      line-height: 1.25;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    /* ── Imagen de fondo completa (logo + greca + OAXACA) ── */
    .fondo-pagina {
      position: fixed;
      top: 0; left: 0;
      width: 21.59cm;
      height: 27.94cm;
      z-index: -10;
      pointer-events: none;
    }
    .fondo-pagina img {
      width: 100%;
      height: 100%;
      object-fit: fill;
    }

    /* ── Encabezado institucional fijo — se repite en todas las páginas ── */
    .page-header {
      position: fixed;
      top: 1.8cm;
      left: 2.2cm;
      right: 2cm;
      z-index: 10;
    }

    /* ── Contenedor principal con márgenes internos del estándar ── */
    .pagina {
      position: relative;
      width: 21.59cm;
      padding: 1.8cm 2cm 1.5cm 2.2cm;
    }

    /* ── HACK: crea margen superior en páginas 2+ para el encabezado fijo ── */
    .page-spacer-wrapper {
      width: 100%;
      border-collapse: collapse;
      border: none;
      margin-top: -7cm;
    }
    .page-spacer-wrapper > thead > tr > td {
      height: 7cm;
      padding: 0;
      border: none;
    }
    .page-spacer-wrapper > tbody > tr > td {
      padding: 0;
      border: none;
      vertical-align: top;
    }

    /* ── Header Texto Central ── */
    .header-text {
      text-align: center;
      font-weight: bold;
      font-size: 9pt;
      color: #777;
      margin-top: 1.2cm;
      margin-bottom: 5pt;
      line-height: 1.2;
      padding-right: 1.2cm;
    }

    .doc-title {
      text-align: center;
      font-size: 14pt;
      font-weight: bold;
      margin-top: 10pt;
      margin-bottom: 2pt;
    }
    .exp-num {
      text-align: right;
      font-weight: bold;
      font-size: 10pt;
      margin-bottom: 2pt;
      padding-right: 1.2cm;
    }

    /* ── Tablas de Sesión ── */
    .session-block {
      width: 100%;
      margin-top: 15pt;
      margin-bottom: 20pt;
      page-break-inside: avoid;
      padding-right: 1.2cm;
    }
    .data-table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
    }
    .data-table td {
      border: 1px solid #000;
      padding: 3pt 5pt;
      vertical-align: top;
      font-size: 9pt;
    }
    .label {
      font-weight: bold;
      background-color: #f2f2f2;
    }
    .sub-label {
      font-weight: bold;
      font-size: 7pt;
      background-color: #fafafa;
    }

    /* ── Footer Estándar ── */
    .oficio-footer {
      position: fixed;
      bottom: 0.3cm;
      right: 1.8cm;
      font-size: 8.5pt;
      color: #888;
      text-align: right;
      line-height: 1.2;
    }

    .signature-box {
      margin-top: 5pt;
      font-weight: bold;
      text-align: left;
      font-size: 9pt;
    }
    .signature-line {
      margin-top: 4pt;
      border-top: 1px solid #000;
      width: 100%;
    }

  </style>
</head>
<body>

  <!-- Fondo oficial con logos y grecas unificadas -->
  <div class="fondo-pagina">
    <img src="{{logoEncabezado}}" alt="" />
  </div>

  <!-- Encabezado institucional fijo — visible en TODAS las páginas al mismo nivel -->
  <div class="page-header">
    <div class="header-text">
      SUBSECRETARIA DE PREVENCIÓN Y REINSERCIÓN SOCIAL<br>
      DIRECCIÓN GENERAL DE PREVENCIÓN DEL DELITO Y PARTICIPACIÓN CIUDADANA<br>
      VALORACIÓN CLÍNICA PSICOLÓGICA
    </div>
    <div class="doc-title">NOTA DE EVOLUCIÓN PSICOLOGICA</div>
    <div class="exp-num">NUM. DE EXPEDIENTE: {{folioExpediente}}</div>
    <div style="padding-right: 1.2cm;">
      <table class="data-table" style="margin-bottom: 5pt;">
        <tr>
          <td class="label" style="width: 25%;">NOMBRE DEL USUARIO:</td>
          <td style="width: 45%;">{{nombreUsuario}}</td>
          <td class="label" style="width: 10%;">EDAD:</td>
          <td style="width: 10%;">{{edad}}</td>
          <td class="label" style="width: 10%;">SEXO:</td>
          <td style="width: 10%;">{{sexo}}</td>
        </tr>
      </table>
    </div>
  </div>

  <div class="pagina">

    <!-- HACK: crea el espacio para el encabezado fijo en pág 2+ con el truco thead/margin-top -->
    <table class="page-spacer-wrapper">
      <thead><tr><td></td></tr></thead>
      <tbody><tr><td>

        <!-- Reserva de espacio en pág. 1 — misma estructura que .page-header pero oculta -->
        <div aria-hidden="true" style="visibility: hidden;">
          <div class="header-text">
            SUBSECRETARIA DE PREVENCIÓN Y REINSERCIÓN SOCIAL<br>
            DIRECCIÓN GENERAL DE PREVENCIÓN DEL DELITO Y PARTICIPACIÓN CIUDADANA<br>
            VALORACIÓN CLÍNICA PSICOLÓGICA
          </div>
          <div class="doc-title">NOTA DE EVOLUCIÓN PSICOLOGICA</div>
          <div class="exp-num">NUM. DE EXPEDIENTE: {{folioExpediente}}</div>
          <div style="padding-right: 1.2cm;">
            <table class="data-table" style="margin-bottom: 5pt;">
              <tr>
                <td class="label" style="width: 25%;">NOMBRE DEL USUARIO:</td>
                <td style="width: 45%;">{{nombreUsuario}}</td>
                <td class="label" style="width: 10%;">EDAD:</td>
                <td style="width: 10%;">{{edad}}</td>
                <td class="label" style="width: 10%;">SEXO:</td>
                <td style="width: 10%;">{{sexo}}</td>
              </tr>
            </table>
          </div>
        </div>

        <!-- Iteración de Sesiones -->
        {{#each sesiones}}
        <div class="session-block">
          <table class="data-table">
            <tr>
              <td class="label" style="width: 15%;">FECHA:</td>
              <td style="width: 35%;">{{fecha}}</td>
              <td class="label" style="width: 10%;">HORA:</td>
              <td style="width: 15%;">{{hora}}</td>
              <td class="label" style="width: 15%;">NUM. DE SESION:</td>
              <td style="width: 10%;">{{numSesion}}</td>
            </tr>
            <tr>
              <td colspan="6" class="sub-label">OBJETIVO DE LA SESION:</td>
            </tr>
            <tr>
              <td colspan="6" style="height: 35pt; text-align: justify;">{{objetivo}}</td>
            </tr>
            <tr>
              <td colspan="6" class="sub-label">CONDUCTA Y DISPOSICION:</td>
            </tr>
            <tr>
              <td colspan="6" style="height: 35pt; text-align: justify;">{{conducta}}</td>
            </tr>
            <tr>
              <td colspan="6" class="sub-label">RESUMEN DE LA SESIÓN (ACTIVIDADES Y ESTRATEGIAS APLICADAS):</td>
            </tr>
            <tr>
              <td colspan="6" style="min-height: 60pt; height: auto; text-align: justify;">
                {{resumen}}
              </td>
            </tr>
            <tr>
              <td colspan="2" class="sub-label">TEMA:</td>
              <td colspan="4">{{tema}}</td>
            </tr>
            <tr>
              <td colspan="2" class="sub-label">ESTRATEGIA:</td>
              <td colspan="4">{{estrategia}}</td>
            </tr>
            <tr>
              <td colspan="6" class="sub-label">PLAN TERAPEUTICO PARA LA SIGUIENTE SESIÓN:</td>
            </tr>
            <tr>
              <td colspan="6" style="height: 35pt; text-align: justify;">{{plan}}</td>
            </tr>
            <tr>
              <td colspan="6" class="sub-label">ACTIVIDADES ASIGNADA PARA EL USUARIO:</td>
            </tr>
            <tr>
              <td colspan="6" style="height: 30pt; text-align: justify;">{{actividades}}</td>
            </tr>
            <tr>
              <td colspan="6" class="sub-label">OBSERVACIONES:</td>
            </tr>
            <tr>
              <td colspan="6" style="height: 30pt; text-align: justify;">{{observaciones}}</td>
            </tr>
            <tr>
              <td colspan="3" class="sub-label">FECHA DE LA PRÓXIMA SESIÓN:</td>
              <td colspan="3">{{fechaProxima}}</td>
            </tr>
            <tr>
              <td colspan="6" class="signature-box" style="background-color: #fafafa;">
                NOMBRE COMPLETO, FIRMA Y CÉDULA PROFESIONAL DE PSICOLOGÍA: 
                <span style="font-weight: normal; font-size: 10.5pt;">Psicóloga {{nombrePsicologo}}</span><br>
                <span style="font-weight: normal; font-size: 8.5pt;">Ced. Profesional: {{cedulaPsicologo}}</span>
                <div class="signature-line"></div>
              </td>
            </tr>
          </table>
        </div>
        {{/each}}

      </td></tr></tbody>
    </table>

  </div>

  <!-- Footer Estándar -->
  <footer class="oficio-footer">
    Privada 5ª, Calle las Águilas, número 124, Av. Universidad,<br>
    Ex Hacienda Candiani, Santa Cruz Xoxocotlán, Oaxaca.<br>
    Teléfono: 01 (951) 51 39272, (951) 51 52917
  </footer>

</body>
</html>
