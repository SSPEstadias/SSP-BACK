<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <title>Plan de Vida Individualizada — {{nombreBeneficiario}}</title>
  <style>
    @page {
      size: Letter landscape;
      margin: 0;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html,
    body {
      font-family: 'Times New Roman', Times, serif;
      font-size: 9.5pt;
      color: #000;
      line-height: 1.3;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    /* ── Grecas Laterales (Vertical) ── */
    .vertical-brand {
      position: fixed;
      right: 0;
      top: 0;
      bottom: 0;
      width: 2.8cm;
      z-index: -10;
      opacity: 0.8;
    }
    .vertical-brand img {
      height: 100vh;
      width: 100%;
      object-fit: cover;
    }

    /* ── Contenedor de Contenido (Aplica márgenes manuales) ── */
    .content-wrapper {
      padding: 1.2cm 3cm 1.2cm 1.5cm;
      width: 100%;
    }

    /* ── Header ── */
    .header-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 5pt;
    }

    .img-seguridad {
      height: 60px;
      width: auto;
    }

    .img-reconecta {
      height: 60px;
      width: auto;
    }

    .bicentenario-text {
      font-size: 10pt;
      font-weight: bold;
      text-align: center;
      margin-top: 5pt;
      margin-bottom: 10pt;
      color: #777;
    }

    /* ── Info del beneficiario ── */
    .meta-info {
      margin-bottom: 15pt;
      font-weight: bold;
      text-transform: uppercase;
      font-size: 10pt;
    }

    .meta-info p {
      margin-bottom: 2pt;
    }

    /* ── Tabla Principal ── */
    .plan-table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
      font-size: 9pt;
      border: 1.5px solid #000;
    }

    .plan-table th {
      background-color: #002060 !important;
      color: #ffffff !important;
      border: 1px solid #000;
      padding: 6pt;
      text-align: center;
      font-size: 9.5pt;
    }

    .plan-table td {
      border: 1px solid #000;
      padding: 6pt;
      vertical-align: middle;
      height: 60pt;
      text-transform: uppercase;
    }

    .col-eje {
      width: 12%;
      font-weight: bold;
      text-align: center;
      background-color: #f2f2f2;
    }

    .col-std {
      width: 14%;
    }

    .col-obs {
      width: 16%;
    }

    /* ── Galería de Imágenes ── */
    .gallery-title {
      margin-top: 30pt;
      font-size: 14pt;
      font-weight: bold;
      text-align: center;
      border-bottom: 2px solid #000;
      padding-bottom: 5pt;
      page-break-before: always;
    }

    .gallery-grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      margin-top: 20pt;
      gap: 20pt;
    }

    .evidence-card {
      width: 45%;
      border: 1px solid #ccc;
      padding: 10pt;
      text-align: center;
      page-break-inside: avoid;
    }

    .evidence-card img {
      max-width: 100%;
      height: 300px;
      object-fit: contain;
      margin-bottom: 8pt;
    }

    .evidence-meta {
      font-size: 9pt;
      color: #555;
      font-style: italic;
    }
  </style>
</head>

<body>

  <!-- Grecas laterales -->
  <div class="vertical-brand">
    {{#if logoGrecas}}
    <img src="{{logoGrecas}}" alt="Grecas" />
    {{/if}}
  </div>

  <div class="content-wrapper">
  <!-- Header repetitivo en cada página -->
  <table style="width: 100%; border: none;">
    <thead>
      <tr>
        <td style="border: none;">
          <table class="header-table">
            <tr>
              <td style="width: 100%; text-align: left;">
                {{#if logoEncabezado}}
                <img src="{{logoEncabezado}}" class="img-seguridad" alt="Seguridad" />
                {{/if}}
              </td>
            </tr>
          </table>
          <div class="bicentenario-text">
            "2025, BICENTENARIO DE LA PRIMERA CONSTITUCIÓN POLÍTICA DEL ESTADO LIBRE Y SOBERANO DE OAXACA"
          </div>
        </td>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td style="border: none;">

          <!-- Metadatos -->
          <div class="meta-info">
            <p>NOMBRE DE LA PERSONA BENEFICIARIA: {{nombreBeneficiario}}</p>
            <p>PERSONA GUÍA ASIGNADA: {{nombreGuia}}</p>
            <p>FECHA DE INGRESO: {{fechaIngreso}}</p>
            <p>TEMPORALIDAD DE LA MEDIDA: {{fechaTemporalidad}}</p>
          </div>

          <!-- Tabla Matriz de Intervención -->
          <table class="plan-table">
            <thead>
              <tr>
                <th style="width: 10%;">EJE</th>
                <th style="width: 14%;">ESTADO INICIAL</th>
                <th style="width: 14%;">ACCIÓN</th>
                <th style="width: 14%;">VINCULACIÓN INSTITUCIONAL</th>
                <th style="width: 14%;">TEMPORALIDAD</th>
                <th style="width: 14%;">SEGUIMIENTO</th>
                <th style="width: 20%;">OBSERVACIONES</th>
              </tr>
            </thead>
            <tbody>
              {{#each ejes}}
              <tr>
                <td class="col-eje">{{eje}}</td>
                <td>{{estadoInicial}}</td>
                <td>{{accion}}</td>
                <td>{{vinculacion}}</td>
                <td>{{temporalidad}}</td>
                <td>{{seguimiento}}</td>
                <td>{{observaciones}}</td>
              </tr>
              {{/each}}
            </tbody>
          </table>

          <!-- Galería de Evidencias (si existen) -->
          {{#if evidencias}}
          <div class="gallery-title">EVIDENCIAS FOTOGRÁFICAS</div>
          <div class="gallery-grid">
            {{#each evidencias}}
            <div class="evidence-card">
              {{#if url}}
              <img src="{{url}}" alt="Evidencia" />
              {{/if}}
              <div class="evidence-meta">
                <strong>{{add @index 1}}. Fecha:</strong> {{fecha}} <br>
                <em>{{actividad}}</em>
              </div>
            </div>
            {{/each}}
          </div>
          {{/if}}

        </td>
      </tr>
    </tbody>
  </table>
  </div>
</body>

</html>