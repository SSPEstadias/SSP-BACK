<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Carátula de Expediente Penal</title>
  <style>
    @page {
      size: Letter;
      margin: 0;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      width: 21.59cm;
      font-family: 'Times New Roman', Times, serif;
      font-size: 11pt;
      color: #000;
      line-height: 1.35;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    body {
      position: relative;
    }

    /* Fondo institucional */
    .fondo-pagina {
      position: fixed;
      top: 0; left: 0;
      width: 21.59cm;
      height: 27.94cm;
      z-index: -10;
      pointer-events: none;
    }
    .fondo-pagina img {
      width: 100%;
      height: 100%;
      object-fit: fill;
    }

    /* Contenedor principal */
    .pagina {
      position: relative;
      width: 21.59cm;
      padding: 1.8cm 2cm 1.5cm 2.2cm;
    }

    /* Encabezado Institucional */
    .header-text {
      text-align: center;
      font-weight: bold;
      font-size: 9pt;
      color: #666;
      margin-top: 1.2cm;
      margin-bottom: 8pt;
      line-height: 1.3;
      padding-right: 1.5cm;
    }

    .doc-title {
      text-align: center;
      font-size: 13pt;
      font-weight: bold;
      margin-top: 10pt;
      margin-bottom: 15pt;
    }

    /* Tabla base profesional */
    .table-container {
      width: 100%;
      margin-bottom: 16pt;
      page-break-inside: auto;
      padding-right: 1.5cm;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
    }

    th, td {
      border: 1px solid #000;
      padding: 6pt;
      vertical-align: top;
      word-wrap: break-word;
      font-size: 10.5pt;
    }

    th {
      text-align: center;
      font-weight: bold;
      background-color: #d9d9d9;
    }

    .label-cell {
      font-weight: bold;
      background-color: #e8e8e8;
      width: 25%;
    }

    .center {
      text-align: center;
      vertical-align: middle;
    }

    .justify {
      text-align: justify;
    }

  </style>
</head>
<body>

  <!-- Fondo oficial -->
  <div class="fondo-pagina">
    <img src="{{logoEncabezado}}" alt="" />
  </div>

  <div class="pagina">

    <!-- Header Institucional -->
    <div class="header-text">
      SUBSECRETARIA DE PREVENCIÓN Y REINSERCIÓN SOCIAL<br>
      DIRECCIÓN GENERAL DE PREVENCIÓN DEL DELITO Y PARTICIPACIÓN CIUDADANA<br>
      PROGRAMA "RECONECTA CON LA PAZ"
    </div>

    <div class="doc-title">CARÁTULA DE EXPEDIENTE</div>

    <!-- Información Básica -->
    <div class="table-container">
      <table>
        <tr>
          <td class="label-cell">C. PENAL:</td>
          <td>{{cPenal}}</td>
        </tr>
        <tr>
          <td class="label-cell">EXPEDIENTE TÉCNICO:</td>
          <td>{{expedienteTecnico}}</td>
        </tr>
        <tr>
          <td class="label-cell">FOLIO DE EXPEDIENTE:</td>
          <td>{{folioExpediente}}</td>
        </tr>
      </table>
    </div>

    <!-- Datos Personales -->
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th colspan="2" style="background-color: #d9d9d9;">DATOS PERSONALES</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="label-cell">NOMBRE(S):</td>
            <td>{{nombre}}</td>
          </tr>
          <tr>
            <td class="label-cell">ALIAS:</td>
            <td>{{alias}}</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Información Legal -->
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th colspan="2" style="background-color: #d9d9d9;">INFORMACIÓN LEGAL</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="label-cell">JUZGADO:</td>
            <td>{{juzgado}}</td>
          </tr>
          <tr>
            <td class="label-cell">DELITO(S):</td>
            <td style="height: 40pt; vertical-align: top;">{{delito}}</td>
          </tr>
          <tr>
            <td class="label-cell">AGRAVIADO(S):</td>
            <td style="height: 40pt; vertical-align: top;">{{agraviado}}</td>
          </tr>
          <tr>
            <td class="label-cell">MEDIDA CAUTELAR:</td>
            <td style="height: 40pt; vertical-align: top;">{{medidaCautelar}}</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Datos del Programa -->
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th colspan="2" style="background-color: #d9d9d9;">DATOS DEL PROGRAMA</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="label-cell">FECHA DE INGRESO:</td>
            <td>{{formatDate fechaIngresoPrograma}}</td>
          </tr>
          <tr>
            <td class="label-cell">FECHA DE SUSPENSIÓN:</td>
            <td>{{formatDate fechaSuspensionProceso}}</td>
          </tr>
          <tr>
            <td class="label-cell">FECHA DE FIN:</td>
            <td>{{formatDate fechaFinSupervision}}</td>
          </tr>
          <tr>
            <td class="label-cell">OBSERVACIONES:</td>
            <td style="height: 50pt; vertical-align: top;">{{observaciones}}</td>
          </tr>
        </tbody>
      </table>
    </div>

  </div>

</body>
</html>
