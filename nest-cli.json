{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "**/*.hbs",
        "watchAssets": true
      },
     {
  "include": "modules/voluntarios/personas/templates/*.csv",
  "outDir": "dist",
  "watchAssets": true
},
      {
        "include": "**/assets/**",
        "watchAssets": true
      }
    ]
  }
}