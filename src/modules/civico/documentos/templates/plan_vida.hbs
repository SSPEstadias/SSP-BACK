{{!-- Plan de Vida Individualizada — SSPC Reconecta con la Paz --}}
{{!--
  Variables requeridas del contexto (documentos.service.ts → generarPlanVida):
    nombreBeneficiario  — Nombre del beneficiario
    nombreGuia          — Nombre del guía asignado (ej: "ESVEL LAGUNAS RODRÍGUEZ")
    fechaIngreso        — Fecha de ingreso al programa (ej: "XX DE MARZO DEL 2025")
    fechaTemporalidad   — Fecha límite de la medida (ej: "20 DE AGOSTO DEL 2025")
    ejes                — Array de ejes del plan de vida (ver estructura abajo)

  Estructura de cada eje en el array:
    {
      eje:                   "SALUD"
      estadoInicial:         "Descripción del estado inicial"
      accion:                "Acción a realizar"
      vinculacion:           "INTERNO / nombre de institución"
      temporalidad:          "CADA 15 DÍAS"
      seguimiento:           "Descripción del seguimiento"
      observaciones:         "Observaciones"
    }

  Variables opcionales:
    folioExpediente  — Folio del expediente
--}}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Plan de Vida Individualizada — {{nombreBeneficiario}}</title>
  <style>
    @page { size: Letter landscape; margin: 2cm 1.5cm 1.5cm 1.5cm; }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Times New Roman', Times, serif; font-size: 10pt; color: #000; line-height: 1.4; }
    .watermark-container { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; }
    .watermark-img { width: 100%; height: 100%; object-fit: fill; opacity: 0.12; }
    .header-table { width: 100%; border-collapse: collapse; margin-bottom: 4pt; }
    .header-logo  { width: 190px; vertical-align: middle; padding-right: 12pt; }
    .logo-img     { width: 180px; height: auto; }
    .header-title { vertical-align: middle; text-align: center; }
    .header-dep   { font-size: 10pt; font-weight: bold; text-transform: uppercase; letter-spacing: 0.4pt; }
    .header-prog  { font-size: 9.5pt; font-weight: bold; color: #1a3a6b; }
    .header-sub   { font-size: 9pt; color: #555; }
    .header-doc-title { font-size: 9.5pt; font-weight: bold; margin-top: 3pt; text-decoration: underline; }
    .header-divider { border-top: 2px solid #1a3a6b; margin: 4pt 0 8pt 0; }
    .doc-footer { position: fixed; bottom: 0; left: 0; right: 0; }
    .footer-divider { border-top: 1px solid #999; margin-bottom: 3pt; }
    .footer-table { width: 100%; border-collapse: collapse; font-size: 7.5pt; color: #555; }
    .footer-left  { text-align: left; } .footer-center { text-align: center; } .footer-right { text-align: right; }
    .content { margin-top: 6pt; }
    .info-header { margin-bottom: 12pt; font-size: 10pt; }
    .info-header p { margin-bottom: 3pt; }
    .info-label { font-weight: bold; text-transform: uppercase; }
    .plan-table { border: 1px solid #999; border-collapse: collapse; width: 100%; font-size: 9.5pt; }
    .plan-table th { background-color: #1a3a6b; color: #fff; padding: 4pt 5pt; border: 1px solid #999; text-align: center; font-size: 9.5pt; }
    .plan-table td { border: 1px solid #ccc; padding: 4pt 5pt; vertical-align: top; }
    .eje-cell { font-weight: bold; background-color: #eef2f9; text-transform: uppercase; }
    .firma-block { margin-top: 20pt; text-align: center; }
    .firma-linea { border-top: 1px solid #000; width: 220px; margin: 0 auto; margin-top: 36pt; }
    .firma-nombre { font-weight: bold; font-size: 10pt; margin-top: 4pt; }
    .firma-cargo  { font-size: 9.5pt; }
  </style>
</head>
<body>

{{> _watermark}}

{{> _header tituloDocumento="PLAN DE VIDA INDIVIDUALIZADA"}}

<div class="content">

  <!-- Datos del beneficiario -->
  <div class="info-header">
    <p><span class="info-label">Nombre de la persona beneficiaria:</span> {{nombreBeneficiario}}</p>
    <p><span class="info-label">Persona guía asignada:</span> {{#if nombreGuia}}{{nombreGuia}}{{else}}—{{/if}}</p>
    <p><span class="info-label">Fecha de ingreso:</span> {{#if fechaIngreso}}{{fechaIngreso}}{{else}}—{{/if}}</p>
    <p><span class="info-label">Temporalidad de la medida:</span> {{#if fechaTemporalidad}}{{fechaTemporalidad}}{{else}}—{{/if}}</p>
  </div>

  <!-- Tabla de ejes del plan de vida -->
  <table class="plan-table">
    <thead>
      <tr>
        <th style="width:8%">EJE</th>
        <th style="width:15%">ESTADO INICIAL</th>
        <th style="width:18%">ACCIÓN</th>
        <th style="width:15%">VINCULACIÓN INSTITUCIONAL</th>
        <th style="width:11%">TEMPORALIDAD</th>
        <th style="width:18%">SEGUIMIENTO</th>
        <th style="width:15%">OBSERVACIONES</th>
      </tr>
    </thead>
    <tbody>
      {{#each ejes}}
      <tr>
        <td class="eje-cell">{{eje}}</td>
        <td>{{estadoInicial}}</td>
        <td>{{accion}}</td>
        <td>{{vinculacion}}</td>
        <td>{{temporalidad}}</td>
        <td>{{seguimiento}}</td>
        <td>{{observaciones}}</td>
      </tr>
      {{/each}}
      {{!-- Filas vacías si no hay datos --}}
      {{#unless ejes}}
      {{#times 8}}
      <tr>
        <td style="height:28pt">&nbsp;</td>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
      </tr>
      {{/times}}
      {{/unless}}
    </tbody>
  </table>

  <!-- Firma -->
  <div class="firma-block">
    <div class="firma-linea"></div>
    <p class="firma-nombre">{{firmaNombre}}</p>
    <p class="firma-cargo">{{#if firmaCargo1}}{{firmaCargo1}}{{/if}}</p>
  </div>

</div>

{{> _footer}}

</body>
</html>
