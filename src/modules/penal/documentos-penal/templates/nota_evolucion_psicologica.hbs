<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <style>
    body {
      font-family: Arial, sans-serif;
      font-size: 12px;
      margin: 20px;
      color: #000;
    }

    h1, h2 {
      text-align: center;
      margin: 0;
    }

    h1 {
      font-size: 18px;
      margin-bottom: 4px;
    }

    h2 {
      font-size: 14px;
      margin-bottom: 16px;
      font-weight: normal;
    }

    .section {
      margin-top: 14px;
    }

    .box {
      border: 1px solid #000;
      padding: 8px;
      margin-top: 4px;
      white-space: pre-wrap;
      word-wrap: break-word;
    }

    .grid {
      width: 100%;
      border-collapse: collapse;
      margin-top: 6px;
    }

    .grid td {
      border: 1px solid #000;
      padding: 6px;
      vertical-align: top;
    }

    .label {
      font-weight: bold;
    }

    .firma {
      margin-top: 40px;
      text-align: center;
    }

    .linea-firma {
      margin: 0 auto;
      width: 260px;
      border-top: 1px solid #000;
      padding-top: 5px;
    }
  </style>
</head>
<body>

  <h1>NOTA DE EVOLUCIÓN PSICOLÓGICA</h1>
  <h2>MÓDULO PENAL</h2>

  <table class="grid">
    <tr>
      <td><span class="label">Folio de expediente:</span> {{folioExpediente}}</td>
      <td><span class="label">Expediente técnico:</span> {{expedienteTecnico}}</td>
    </tr>
    <tr>
      <td><span class="label">C. Penal:</span> {{cPenal}}</td>
      <td><span class="label">Beneficiario:</span> {{nombreBeneficiario}}</td>
    </tr>
    <tr>
      <td><span class="label">Fecha:</span> {{formatDate fecha}}</td>
      <td><span class="label">Número de sesión:</span> {{numeroSesion}}</td>
    </tr>
    <tr>
      <td colspan="2"><span class="label">Psicólogo:</span> {{psicologo}}</td>
    </tr>
  </table>

  <div class="section">
    <div class="label">Objetivo de la sesión</div>
    <div class="box">{{objetivoSesion}}</div>
  </div>

  <div class="section">
    <div class="label">Descripción de la sesión</div>
    <div class="box">{{descripcionSesion}}</div>
  </div>

  <div class="section">
    <div class="label">Técnicas aplicadas</div>
    <div class="box">{{tecnicasAplicadas}}</div>
  </div>

  <div class="section">
    <div class="label">Avances</div>
    <div class="box">{{avances}}</div>
  </div>

  <div class="section">
    <div class="label">Observaciones</div>
    <div class="box">{{observaciones}}</div>
  </div>

  <div class="section">
    <div class="label">Próxima sesión</div>
    <div class="box">{{formatDate proximaSesion}}</div>
  </div>

  <div class="firma">
    <div class="linea-firma">{{psicologo}}</div>
    <div>Psicólogo responsable</div>
  </div>

</body>
</html>